# SOC Detection Lab - Environment Configuration Template
# Copy this file to .env and fill in actual values for your environment

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
NODE_ENV=development
APP_NAME=SOC-Detection-Lab
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=localhost
LOG_LEVEL=debug

# ============================================================
# DATABASE CONFIGURATION - PostgreSQL
# ============================================================
# Primary database for transactional data
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_detection_lab
DB_USER=soc_admin
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================
# OPENSEARCH/ELASTICSEARCH CONFIGURATION
# ============================================================
# For event storage and log analysis
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your_opensearch_password
OPENSEARCH_INDEX_PREFIX=soc-
OPENSEARCH_SHARDS=5
OPENSEARCH_REPLICAS=1

# ============================================================
# REDIS CONFIGURATION
# ============================================================
# For caching and session management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SESSION=86400
REDIS_TTL_CACHE=3600

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================
# JWT token configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d

# Password hashing
BCRYPT_ROUNDS=12

# Session configuration
SESSION_SECRET=your_session_secret_here
SESSION_EXPIRATION=86400

# ============================================================
# ENCRYPTION
# ============================================================
# For encrypting sensitive data in database
ENCRYPTION_KEY=your_encryption_key_here_32_chars
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================
# API KEYS & INTEGRATIONS
# ============================================================
# Third-party service integrations
SLACK_API_TOKEN=xoxb-your-slack-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_API_KEY=your-pagerduty-key
SPLUNK_HEC_URL=https://splunk-instance:8088
SPLUNK_HEC_TOKEN=your-hec-token

# ============================================================
# MONITORING & OBSERVABILITY
# ============================================================
# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_INTERVAL=60000

# Logging
LOG_FORMAT=json
LOG_TRANSPORT=console,file
LOG_FILE_PATH=./logs/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_MAX_FILES=10

# Error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=0.1

# ============================================================
# ML/DETECTION ENGINE
# ============================================================
# ML model configuration
ML_MODEL_PATH=./models
ML_MODEL_VERSION=1.0.0
ML_CONFIDENCE_THRESHOLD=0.75
ML_ANOMALY_THRESHOLD=0.8

# Rule engine
RULE_ENGINE_TIMEOUT=5000
RULE_EVALUATION_BATCH_SIZE=1000

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_WS_URL=ws://localhost:3000
REACT_APP_ENV=development
REACT_APP_LOG_LEVEL=debug
REACT_APP_ANALYTICS_ENABLED=false

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=SOC Detection Lab <noreply@example.com>
SMTP_TLS=true

# ============================================================
# AUDIT & COMPLIANCE
# ============================================================
# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_STORAGE=database

# Compliance settings
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365
DATA_ANONYMIZATION_ENABLED=true

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_ML_DETECTION=true
FEATURE_ANOMALY_DETECTION=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_CASE_MANAGEMENT=true
FEATURE_AUTOMATED_RESPONSE=true
FEATURE_WEBHOOK_INTEGRATION=true

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests, please try again later

# ============================================================
# CORS & SECURITY HEADERS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_HEADERS=Content-Type,Authorization

# Security headers
HELMET_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
STRICT_TRANSPORT_SECURITY=max-age=31536000;includeSubDomains

# ============================================================
# DEPLOYMENT
# ============================================================
# Container and orchestration
DOCKER_REGISTRY=your-registry
DOCKER_IMAGE_TAG=latest
K8S_NAMESPACE=default
K8S_REPLICAS=1

# Load balancer
LB_ENABLED=false
LB_TIMEOUT=30000
LB_MAX_CONNECTIONS=1000

# ============================================================
# DEBUG & DEVELOPMENT
# ============================================================
DEBUG=soc-lab:*
VERBOSE_LOGGING=false
MOCK_EXTERNAL_SERVICES=true
DEVELOPMENT_MODE=true
HOT_RELOAD_ENABLED=true
