{
  "name": "soc-detection-lab",
  "version": "2.0.0",
  "description": "Professional SOC Detection Lab - Enterprise Security Monitoring and Threat Detection Platform",
  "main": "dist/backend/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:frontend": "cd src/frontend && npm run build",
    "dev": "run-p dev:backend dev:frontend",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "cd src/frontend && npm run dev",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.unit.js --coverage",
    "test:integration": "jest --config jest.config.integration.js",
    "test:e2e": "cypress run",
    "test:watch": "jest --watch",
    "lint": "eslint src/backend/index.ts src/backend/api src/backend/services --ext .ts",
    "lint:fix": "eslint src/backend/index.ts src/backend/api src/backend/services --ext .ts --fix",
    "lint:frontend": "npm run lint --prefix src/frontend",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --project tsconfig.backend.json --noEmit && cd src/frontend && tsc --noEmit",
    "clean": "rimraf dist build coverage .nyc_output",
    "docs": "typedoc --out ./docs/api ./src",
    "precommit": "lint-staged",
    "prepare": "husky install",
    "start": "node dist/backend/index.js",
    "start:prod": "NODE_ENV=production node dist/backend/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:logs": "pm2 logs",
    "docker:build": "docker build -t soc-detection-lab:latest .",
    "docker:run": "docker run -it --env-file .env soc-detection-lab:latest",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "smoke-test": "bash scripts/smoke-test.sh",
    "health": "curl http://localhost:3000/api/v1/health"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^2.3.1",
    "@sentry/node": "^7.88.0",
    "@types/ws": "^8.5.13",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.17.21",
    "p-queue": "^7.4.1",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "prom-client": "^15.0.0",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.1.14",
    "typescript": "^5.2.2",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cypress": "^13.6.2",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "knex": "^3.0.1",
    "lint-staged": "^15.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typedoc": "^0.25.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "SOC",
    "security",
    "monitoring",
    "detection",
    "threat",
    "investigation",
    "SIEM"
  ],
  "author": "Development Team",
  "license": "MIT"
}
